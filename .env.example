# ================================================================
# NotifyHub — Environment Variables
# Copy this file to .env and fill in the values before running.
# NEVER commit the actual .env file to version control.
# ================================================================

# ----------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=notifyhub
DB_USERNAME=notifyhub
DB_PASSWORD=change_me_postgres_password

# ----------------------------------------------------------------
# RabbitMQ
# ----------------------------------------------------------------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=change_me_rabbitmq_password

# ----------------------------------------------------------------
# Redis
# ----------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ----------------------------------------------------------------
# JWT
# Generate a strong 256-bit Base64-encoded secret:
#   openssl rand -base64 32
# ----------------------------------------------------------------
JWT_SECRET=replace_with_a_256_bit_base64_encoded_secret_key
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000
